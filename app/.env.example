AI_BASE_URL=https://ai.sumopod.com/v1
AI_API_KEY=
AI_MODEL=

# Live defaults to disabled; replay requires none of these.
# direct = public demo without passcode/quota/Redis; needs only provider key/model.
# local = loopback demo; public = protected HTTPS demo with shared Redis guards.
# Keep disabled until the matching access configuration is complete.
AI_LIVE_MODE=disabled
DEMO_PASSCODE=
DEMO_SESSION_SECRET=
# Required operational caps. Public mode enforces these across server instances.
AI_MAX_CALLS_PER_MINUTE=2
AI_MAX_CALLS_PER_DAY=20
AI_MAX_CONCURRENT=1

# Required for public/Vercel live. Exact origins only, no paths/trailing slash/wildcards.
# Example: https://your-project.vercel.app,https://your-custom-domain.example
AI_ALLOWED_ORIGINS=
# Upstash-compatible Redis REST endpoint and write-capable token; server-only.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Stable across deployments so restarting does not reset public quotas.
AI_QUOTA_NAMESPACE=caliber-production
