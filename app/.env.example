AI_BASE_URL=https://ai.sumopod.com/v1
AI_API_KEY=
AI_MODEL=

# Live defaults to disabled; replay requires none of these.
# Local loopback demo only. Public/Vercel live is disabled until shared guards exist.
AI_LIVE_MODE=disabled
DEMO_PASSCODE=
DEMO_SESSION_SECRET=
# Explicit operational limits for a single local server (not distributed limits).
AI_MAX_CALLS_PER_MINUTE=2
AI_MAX_CALLS_PER_DAY=20
AI_MAX_CONCURRENT=1
